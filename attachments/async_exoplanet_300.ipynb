        "# ============================================================================",
        "# ASYNC HTTP: aiohttp — 批量查询 NASA Exoplanet Archive",
        "# 获取已知行星参数，用于后续交叉验证",
        "# ============================================================================",
        "",
        "KNOWN_PLANETS_CACHE = os.path.join(OUTPUT_DIR, 'known_planets.csv')",
        "",
        "",
        "async def fetch_known_planets(session, sem_http):",
        "    \"\"\"",
        "    使用 aiohttp 异步查询 NASA Exoplanet Archive TAP API，",
        "    获取所有已确认行星的公转周期和半径（用于交叉验证）。",
        "    \"\"\"",
        "    async with sem_http:",
        "        url = 'https://exoplanetarchive.ipac.caltech.edu/TAP/sync'",
        "        query = (",
        "            'SELECT pl_name, hostname, pl_orbper, pl_rade, pl_bmasse, '",
        "            'discoverymethod, disc_year, pl_facility '",
        "            'FROM ps WHERE default_flag=1 AND pl_facility LIKE \"%TESS%\"'",
        "        )",
        "        params = {'query': query, 'format': 'json'}",
        "        try:",
        "            async with session.get(url, params=params, timeout=30) as resp:",
        "                if resp.status == 200:",
        "                    data = await resp.json()",
        "                    return data",
        "                else:",
        "                    print(f'  [HTTP] Known planets query returned {resp.status}')",
        "                    return None",
        "        except Exception as e:",
        "            print(f'  [HTTP] Known planets query failed: {e}')",
        "            return None",
        "",
        "",
        "async def resolve_target_mast(session, target, sem_http):",
        "    \"\"\"",
        "    使用 aiohttp 调用 MAST resolver API，",
        "    检查目标星是否可被 MAST 解析（预筛选有数据的星）。",
        "    \"\"\"",
        "    async with sem_http:",
        "        url = 'https://mast.stsci.edu/api/v0.1/resolver/resolve'",
        "        params = {'name': target}",
        "        try:",
        "            async with session.get(url, params=params, timeout=10) as resp:",
        "                if resp.status == 200:",
        "                    data = await resp.json()",
        "                    resolved = data.get('resolved', False)",
        "                    return target, resolved",
        "        except Exception:",
        "            pass",
        "        return target, False"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ============================================================================",
        "# ASYNC DOWNLOAD + PROCESS: asyncio + ThreadPoolExecutor",
        "# ============================================================================",
        "",
        "# 全局控制",
        "sem_download = None          # 下载并发信号量",
        "executor = None              # 线程池执行器",
        "results_store = []           # 结果汇总",
        "results_lock = None          # 异步锁",
        "progress_counter = 0         # 进度计数",
        "",
        "",
        "def sync_search_and_download(target, cache_dir):",
        "    \"\"\"同步搜索 + 下载（将在线程池中执行）\"\"\"",
        "    search = lk.search_lightcurve(target, author='SPOC')",
        "    if len(search) == 0:",
        "        search = lk.search_lightcurve(target, author='TESS-SPOC')",
        "    if len(search) == 0:",
        "        return None, None, None",
        "    try:",
        "        lc = search[0].download(download_dir=cache_dir)",
        "    except Exception:",
        "        return None, None, None",
        "    if lc is None:",
        "        return None, None, None",
        "    sector = int(getattr(lc, 'sector', -1))",
        "    return lc, sector, search",
        "",
        "",
        "def sync_process(lc, target, sector):",
        "    \"\"\"同步 BLS 处理（将在线程池中执行）\"\"\"",
        "    try:",
        "        lc_clean = lc.remove_nans().remove_outliers(sigma=5).flatten()",
        "        if len(lc_clean.time) < 50:",
        "            return None",
        "        result = process_lightcurve(lc_clean, target, sector)",
        "        return result",
        "    except Exception:",
        "        return None",
        "",
        "",
        "async def process_one_target(target, progress_callback=None):",
        "    \"\"\"异步处理单个目标：信号量控制并发 + 线程池执行\"\"\"",
        "    global results_store, results_lock, progress_counter",
        "    async with sem_download:",
        "        loop = asyncio.get_running_loop()",
        "        # Step 1: 搜索 + 下载（线程池）",
        "        lc, sector, search = await loop.run_in_executor(",
        "            executor, sync_search_and_download, target, DOWNLOAD_CACHE_DIR",
        "        )",
        "        if lc is None:",
        "            async with results_lock:",
        "                progress_counter += 1",
        "            if progress_callback:",
        "                progress_callback(target, None)",
        "            return None",
        "        # Step 2: BLS 处理（线程池）",
        "        result = await loop.run_in_executor(",
        "            executor, sync_process, lc, target, sector",
        "        )",
        "        async with results_lock:",
        "            progress_counter += 1",
        "            if result is not None:",
        "                results_store.append(result)",
        "        if progress_callback:",
        "            progress_callback(target, result)",
        "        return result"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ============================================================================",
        "# MAIN ASYNC PIPELINE",
        "# ============================================================================",
        "",
        "async def main_pipeline(targets, max_concurrent=8):",
        "    \"\"\"主异步管线：查询已知行星 → 解析目标 → 下载 + BLS → 汇总\"\"\"",
        "    global sem_download, executor, results_store, results_lock, progress_counter",
        "",
        "    # 初始化全局控制对象",
        "    sem_download = asyncio.Semaphore(max_concurrent)",
        "    sem_http = asyncio.Semaphore(HTTP_CONCURRENT)",
        "    executor = ThreadPoolExecutor(max_workers=max_concurrent)",
        "    results_store = []",
        "    results_lock = asyncio.Lock()",
        "    progress_counter = 0",
        "",
        "    t_start = time.time()",
        "    total = len(targets)",
        "",
        "    print(f'\\n{\"=\"*60}')",
        "    print(f'ASYNC EXOPLANET HUNTER — {total} targets, {max_concurrent} concurrent')",
        "    print(f'{\"=\"*60}')",
        "",
        "    # ── Phase 1: 异步查询已知行星数据库 ──",
        "    print(f'\\n[Phase 1] Fetching known TESS planets from NASA Exoplanet Archive...')",
        "    known_df = None",
        "    async with aiohttp.ClientSession() as session:",
        "        t0 = time.time()",
        "        known_data = await fetch_known_planets(session, sem_http)",
        "        if known_data and len(known_data) > 0:",
        "            known_df = pd.DataFrame(known_data)",
        "            known_df.to_csv(KNOWN_PLANETS_CACHE, index=False)",
        "            print(f'  [OK] Retrieved {len(known_df)} known TESS planets ({time.time()-t0:.1f}s)')",
        "            print(f'  Saved to {KNOWN_PLANETS_CACHE}')",
        "        else:",
        "            print(f'  [WARN] Could not fetch known planets, continuing without cross-match')",
        "",
        "        # ── Phase 2: 异步解析目标（预筛选）──",
        "        print(f'\\n[Phase 2] Resolving {total} targets via MAST API (aiohttp)...')",
        "        t0 = time.time()",
        "        resolve_tasks = [resolve_target_mast(session, t, sem_http) for t in targets]",
        "        resolve_results = await asyncio.gather(*resolve_tasks, return_exceptions=True)",
        "        resolvable = [t for t, ok in resolve_results if ok and not isinstance(t, Exception)]",
        "        failed_resolve = total - len(resolvable)",
        "        print(f'  [OK] {len(resolvable)}/{total} targets resolvable in MAST ({time.time()-t0:.1f}s)')",
        "        if failed_resolve > 0:",
        "            print(f'  [INFO] {failed_resolve} targets not found in MAST, will try anyway')",
        "",
        "    # ── Phase 3: 异步下载 + BLS 处理 ──",
        "    print(f'\\n[Phase 3] Async download + BLS processing ({max_concurrent} concurrent)...')",
        "    print(f'  Target: {TARGET_SAMPLE_COUNT} samples | Period: {MIN_PERIOD}-{MAX_PERIOD}d')",
        "    print(f'  BLS: {N_PERIODS_BLS} periods x {N_DURATIONS_BLS} durations | Bootstrap: {N_BOOTSTRAP}')",
        "    print()",
        "",
        "    success_count = [0]",
        "    fail_count = [0]",
        "    fp_count = [0]",
        "",
        "    async with aiohttp.ClientSession() as session:",
        "        def on_progress(target, result):",
        "            n = progress_counter",
        "            s = success_count[0]",
        "            if result is not None:",
        "                s += 1",
        "                success_count[0] = s",
        "                fp_count[0] += int(result.get('False Positive', False))",
        "                snr = result['SNR']",
        "                period = result['Period (d)']",
        "                fp_mark = '[FP]' if result['False Positive'] else '[OK]'",
        "                # 实时打印",
        "                print(f'  [{n}/{total}] {fp_mark} {target:20s} P={period:9.4f}d  SNR={snr:6.1f}  ({s} ok)')",
        "            else:",
        "                fail_count[0] += 1",
        "                if n % 20 == 0:",
        "                    print(f'  [{n}/{total}] --- {target:20s}  (no data / failed)')",
        "            # 达到 300 样本后提前停止",
        "            if success_count[0] >= TARGET_SAMPLE_COUNT:",
        "                pass  # 继续但不强制取消（asyncio gather 不支持中途取消子任务）",
        "",
        "        tasks = [process_one_target(t, on_progress) for t in targets]",
        "        await asyncio.gather(*tasks, return_exceptions=True)",
        "",
        "    elapsed = time.time() - t_start",
        "    print(f'\\n{\"=\"*60}')",
        "    print(f'PIPELINE COMPLETE in {elapsed/60:.1f} min ({elapsed:.0f}s)')",
        "    print(f'  Success: {success_count[0]} | Failed/NoData: {fail_count[0]} | Flagged FP: {fp_count[0]}')",
        "    print(f'  Strong candidates (not FP): {success_count[0] - fp_count[0]}')",
        "    print(f'{\"=\"*60}')",
        "",
        "    executor.shutdown(wait=True)",
        "    return results_store"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ============================================================================",
        "# RUN THE PIPELINE",
        "# ============================================================================",
        "",
        "# 运行异步管线",
        "results = await main_pipeline(NAMED_TARGETS, max_concurrent=MAX_CONCURRENT)",
        "",
        "# 构建 DataFrame",
        "df = pd.DataFrame(results)",
        "",
        "# 截取前 300 个样本（如果不是 FP 的优先）",
        "if len(df) > TARGET_SAMPLE_COUNT:",
        "    df_good = df[~df['False Positive']].head(TARGET_SAMPLE_COUNT)",
        "    if len(df_good) < TARGET_SAMPLE_COUNT:",
        "        # 不够的话用 FP 补",
        "        df_fp = df[df['False Positive']].head(TARGET_SAMPLE_COUNT - len(df_good))",
        "        df = pd.concat([df_good, df_fp], ignore_index=True)",
        "    else:",
        "        df = df_good",
        "",
        "print(f'\\nFinal dataset: {len(df)} samples')"
      ],
      "outputs": [],
      "execution_count": null
    },
