      "source": [
        "# TESS Exoplanet Hunter — Async 300-Sample Pipeline",
        "",
        "使用 **asyncio + aiohttp + ThreadPoolExecutor** 异步下载 TESS 光变曲线数据，",
        "通过 BLS (Box Least Squares) 周期图搜索系外行星候选体，生成 **300 样本** 的 CSV 文件。",
        "",
        "## 异步技术栈",
        "- `aiohttp` — 异步 HTTP 查询 MAST / NASA Exoplanet Archive",
        "- `asyncio.Semaphore` — 并发控制（最多 8 个同时下载）",
        "- `ThreadPoolExecutor` — 将同步的 lightkurve 调用放入线程池异步执行",
        "- `asyncio.as_completed` — 实时进度追踪",
        "- `nest_asyncio` — Jupyter 事件循环兼容"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import asyncio",
        "import time",
        "import os",
        "import sys",
        "import warnings",
        "from concurrent.futures import ThreadPoolExecutor",
        "from dataclasses import dataclass, field",
        "from typing import Optional",
        "",
        "import nest_asyncio",
        "import aiohttp",
        "import numpy as np",
        "import pandas as pd",
        "import matplotlib.pyplot as plt",
        "import lightkurve as lk",
        "from astropy.timeseries import BoxLeastSquares",
        "",
        "warnings.filterwarnings('ignore')",
        "plt.rcParams['figure.facecolor'] = 'white'",
        "",
        "# Jupyter 事件循环兼容",
        "nest_asyncio.apply()",
        "",
        "print('[OK] All imports ready.')"
      ],
      "outputs": [],
      "execution_count": null
    },
