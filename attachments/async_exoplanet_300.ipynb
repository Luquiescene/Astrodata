        "# ============================================================================",
        "# BLS PIPELINE FUNCTIONS (inlined from exoplanet_bls_pipeline.py)",
        "# ============================================================================",
        "",
        "def extract_arrays(lc_flat):",
        "    \"\"\"Extract time, flux, flux_err from flattened light curve.\"\"\"",
        "    time = np.asarray(lc_flat.time.value, dtype=float)",
        "    flux = np.asarray(lc_flat.flux.value, dtype=float)",
        "    if getattr(lc_flat, 'flux_err', None) is not None:",
        "        flux_err = np.asarray(lc_flat.flux_err.value, dtype=float)",
        "    else:",
        "        flux_err = None",
        "    good = np.isfinite(time) & np.isfinite(flux)",
        "    if flux_err is not None:",
        "        good &= np.isfinite(flux_err)",
        "        flux_err = flux_err[good]",
        "    else:",
        "        mad = np.nanmedian(np.abs(flux - np.nanmedian(flux)))",
        "        flux_err = np.full(good.sum(), 1.4826 * mad)",
        "    time, flux = time[good], flux[good]",
        "    order = np.argsort(time)",
        "    return time[order], flux[order], flux_err[order]",
        "",
        "",
        "def run_bls(time, flux, flux_err, min_period=0.5, max_period=40.0,",
        "            n_periods=8000, min_dur_hr=0.5, max_dur_hr=6.0, n_durations=6):",
        "    \"\"\"Run Box Least Squares periodogram.\"\"\"",
        "    bls = BoxLeastSquares(time, flux, dy=flux_err)",
        "    periods = np.linspace(min_period, max_period, n_periods)",
        "    durations = np.linspace(min_dur_hr / 24.0, max_dur_hr / 24.0, n_durations)",
        "    result = bls.power(periods, durations, objective='snr')",
        "    best_idx = int(np.argmax(result.power))",
        "    best = {",
        "        'period': float(result.period[best_idx]),",
        "        'duration': float(result.duration[best_idx]),",
        "        't0': float(result.transit_time[best_idx]),",
        "        'power': float(result.power[best_idx]),",
        "        'depth': float(result.depth[best_idx]),",
        "        'depth_err': float(result.depth_err[best_idx]),",
        "        'depth_snr': float(result.depth_snr[best_idx]),",
        "    }",
        "    return bls, result, best",
        "",
        "",
        "def bootstrap_errors(time, flux, flux_err, best, n_boot=30, random_state=42):",
        "    \"\"\"Bootstrap period and depth uncertainties.\"\"\"",
        "    rng = np.random.default_rng(random_state)",
        "    n = len(time)",
        "    block_size = max(50, n // 20)",
        "    n_blocks = int(np.ceil(n / block_size))",
        "    lo = best['period'] * 0.95",
        "    hi = best['period'] * 1.05",
        "    boot_grid = np.linspace(lo, hi, 300)",
        "    durations = np.array([best['duration']])",
        "    boot_periods, boot_depths = [], []",
        "    for _ in range(n_boot):",
        "        starts = rng.integers(0, n_blocks, size=n_blocks) * block_size",
        "        idx = np.concatenate([np.arange(s, min(s + block_size, n)) for s in starts])",
        "        idx = idx[idx < n]",
        "        if len(idx) < 10:",
        "            continue",
        "        t_b, f_b, e_b = time[idx], flux[idx], flux_err[idx]",
        "        order = np.argsort(t_b)",
        "        t_b, f_b, e_b = t_b[order], f_b[order], e_b[order]",
        "        try:",
        "            bls_b = BoxLeastSquares(t_b, f_b, dy=e_b)",
        "            res_b = bls_b.power(boot_grid, durations, objective='snr')",
        "            j = int(np.argmax(res_b.power))",
        "            boot_periods.append(res_b.period[j])",
        "            boot_depths.append(res_b.depth[j])",
        "        except Exception:",
        "            continue",
        "    if len(boot_periods) > 5:",
        "        return {",
        "            'period_err': float(np.std(boot_periods)),",
        "            'depth_err': float(np.std(boot_depths)),",
        "            'n_draws': len(boot_periods),",
        "        }",
        "    return {'period_err': np.nan, 'depth_err': np.nan, 'n_draws': len(boot_periods)}",
        "",
        "",
        "def vet_candidate(best, stats, snr_threshold=5.0):",
        "    \"\"\"Simple vetting: SNR, odd-even, depth checks.\"\"\"",
        "    flags = []",
        "    depth_odd, depth_odd_err = stats['depth_odd']",
        "    depth_even, depth_even_err = stats['depth_even']",
        "    odd_even_sigma = np.nan",
        "    if np.isfinite(depth_odd_err) and np.isfinite(depth_even_err):",
        "        combined = np.sqrt(depth_odd_err**2 + depth_even_err**2)",
        "        if combined > 0:",
        "            odd_even_sigma = abs(depth_odd - depth_even) / combined",
        "    if np.isfinite(odd_even_sigma) and odd_even_sigma > 3:",
        "        flags.append(f'odd/even mismatch ({odd_even_sigma:.1f}sigma)')",
        "    if best['depth'] * 1e6 > 30000:",
        "        flags.append(f'depth {best[\"depth\"]*1e6:,.0f} ppm > 30000')",
        "    if best['duration'] / best['period'] > 0.15:",
        "        flags.append('duration/period > 0.15')",
        "    if best['depth_snr'] < snr_threshold:",
        "        flags.append(f'SNR {best[\"depth_snr\"]:.1f} < {snr_threshold}')",
        "    is_fp = len(flags) > 0",
        "    return is_fp, flags, odd_even_sigma",
        "",
        "",
        "def process_lightcurve(lc_flat, target_name, sector):",
        "    \"\"\"Full BLS search + vetting pipeline for one target.\"\"\"",
        "    time, flux, flux_err = extract_arrays(lc_flat)",
        "    bls, result, best = run_bls(",
        "        time, flux, flux_err,",
        "        min_period=MIN_PERIOD, max_period=MAX_PERIOD,",
        "        n_periods=N_PERIODS_BLS, n_durations=N_DURATIONS_BLS,",
        "    )",
        "    stats = bls.compute_stats(best['period'], best['duration'], best['t0'])",
        "    boot = bootstrap_errors(time, flux, flux_err, best, n_boot=N_BOOTSTRAP)",
        "    is_fp, fp_reasons, odd_even = vet_candidate(best, stats, snr_threshold=SNR_THRESHOLD)",
        "    return {",
        "        'Target': target_name,",
        "        'Sector': sector,",
        "        'Period (d)': round(best['period'], 5),",
        "        'Period Err (d)': round(boot['period_err'], 5) if np.isfinite(boot['period_err']) else np.nan,",
        "        'Depth (ppm)': round(best['depth'] * 1e6, 1),",
        "        'Duration (hr)': round(best['duration'] * 24.0, 3),",
        "        'SNR': round(best['depth_snr'], 2),",
        "        'False Positive': is_fp,",
        "        'FP_Reasons': '; '.join(fp_reasons) if fp_reasons else '',",
        "        'Odd_Even_Sigma': round(odd_even, 2) if np.isfinite(odd_even) else np.nan,",
        "    }",
        "",
        "print('[OK] BLS pipeline functions defined.')"
      ],
      "outputs": [],
      "execution_count": null
    },
