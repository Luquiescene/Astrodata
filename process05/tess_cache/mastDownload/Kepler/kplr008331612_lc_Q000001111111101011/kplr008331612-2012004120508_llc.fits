          1 / group count (not used)                         INHERIT =                    T / inherit the primary header                     EXTNAME = 'APERTURE'           / name of extension                              EXTVER  =                    1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 8331612'        / string version of target id                    KEPLERID=              8331612 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           301.278690 / [deg] right ascension                          DEC_OBJ =            44.250530 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    4.260285866312216 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.883304301734711 / [pixel] reference pixel along image axis 2     CRVAL1  =            301.27869 / [deg] right ascension at reference pixel       CRVAL2  =             44.25053 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001101341120761 / [deg] pixel scale in RA dimension              CDELT2  =    0.001101341120761 / [deg] pixel scale in Dec dimension             PC1_1   =   0.4288513430700855 / linear transformation element cos(th)          PC1_2   =   0.9003729898197407 / linear transformation element -sin(th)         PC2_1   =   0.90499