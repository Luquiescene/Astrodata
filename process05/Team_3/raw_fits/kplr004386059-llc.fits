ope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 4386059'        / string version of target id                    KEPLERID=              4386059 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           296.434086 / [deg] right ascension                          DEC_OBJ =            39.444068 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    3.266878793407102 / [pixel] reference pixel along image axis 1     CRPIX2  =   2.6283116570780294 / [pixel] reference pixel along image axis 2     CRVAL1  =           296.434086 / [deg] right ascension at reference pixel       CRVAL2  =            39.444068 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  = -0.00110497724130889 / [deg] pixel scale in RA dimension              CDELT2  =  0.00110497724130889 / [deg] pixel scale in Dec dimension             PC1_1   =   0.8733309504340622 / linear transformation element cos(th)          PC1_2   =  0.48755347458305154 / linear transformation element -sin(th)         PC2_1   =   -0.487512539634701 / linear transformation element sin(th)          PC2_2   =   0.8728782221898933 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physic