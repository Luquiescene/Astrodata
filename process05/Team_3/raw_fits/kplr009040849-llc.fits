 telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 9040849'        / string version of target id                    KEPLERID=              9040849 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           297.605300 / [deg] right ascension                          DEC_OBJ =            45.360680 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    4.106413906560107 / [pixel] reference pixel along image axis 1     CRPIX2  =     2.85845407114698 / [pixel] reference pixel along image axis 2     CRVAL1  =          297.6052995 / [deg] right ascension at reference pixel       CRVAL2  =             45.36068 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001105598396982 / [deg] pixel scale in RA dimension              CDELT2  =    0.001105598396982 / [deg] pixel scale in Dec dimension             PC1_1   = -0.47153523836385736 / linear transformation element cos(th)          PC1_2   =  -0.8833473561638273 / linear transformation element -sin(th)         PC2_1   =  -0.8806337477765799 / linear transformation element sin(th)          PC2_2   =    0.471002989985528 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           /